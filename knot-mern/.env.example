# Copy to knot-mern/.env (or export the variables). The server reads this file first.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
# MongoDB connection string. Use a local mongod or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/knot_dev
# Required in production: a long random string (16+ chars).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated origins allowed by CORS (the Vite dev server by default).
CLIENT_ORIGINS=http://localhost:5173
# Public URL of the web app, used in links inside notifications and calendar files.
PUBLIC_URL=http://localhost:5173
# Background jobs: start reminders, waitlist housekeeping. Cron uses node-cron syntax.
ENABLE_JOBS=true
JOB_CRON=*/5 * * * *
# Requests allowed per 15 minutes on /api (auth routes have a stricter limit).
RATE_LIMIT_MAX=300
LOG_LEVEL=info

# --- Client (Vite dev server / build) -------------------------------------
# Where the Vite dev server proxies /api and /socket.io. Browsers only use relative URLs.
API_URL=http://localhost:5000
# Optional map tiles. Defaults to OpenStreetMap; set a provider key if you need one.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
